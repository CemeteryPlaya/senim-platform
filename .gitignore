/.claude/sessions/
/.claude/memory/
/.claude/settings.local.json
/.claude/worktrees/
/.harness-worktrees/
/.codebase-memory/
/.remember/

# локальное хранилище файлов (StorageProvider=local)
/storage/

# тесты
/test-results/
/playwright-report/
/blob-report/

# пример переменных окружения — в git
!.env.example

# Скиллы сторонних инструментов — только локально (решение владельца, OPEN_QUESTIONS №1)
/.agents/

# Скопируйте в .env и заполните. Реальные ключи в git не коммитим.
# Все переменные проверяются zod-схемой в src/platform/env.ts при первом обращении.

# ─── База данных ─────────────────────────────────────────────
# Postgres из docker-compose.yml (npm run db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5442/senim?schema=public"
# Отдельная база для интеграционных тестов (создаётся docker/postgres-init.sql)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5442/senim_test?schema=public"
# Отдельная база для Playwright: пересоздаётся с демо-данными перед каждым прогоном
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5442/senim_e2e?schema=public"

# ─── Приложение ──────────────────────────────────────────────
# Публичный адрес приложения: ссылки в SMS, подписанные ссылки на файлы
APP_URL="http://localhost:3100"
# true — включает демо-персоны, «Сбросить демо», страницу показа банку и переключатель PaymentRail.
# В рабочем окружении с реальными клиентами — только false.
DEMO_MODE="true"
# Пароль показа демо-стенда. При DEMO_MODE=true и непустом пароле весь сайт закрыт basic-auth
# (имя пользователя любое; вебхуки /api/webhooks/* и /api/cron/* — без пароля, у них своя подпись).
# Обязателен в production при DEMO_MODE=true, не короче 16 символов (например: openssl rand -base64 24).
# С паролем обязателен и CRON_SECRET. Локально и в e2e оставьте пустым.
DEMO_ACCESS_PASSWORD=""
# Уровень логов: debug | info | warn | error
LOG_LEVEL="info"
# true — сайт за доверенным прокси, который сам ставит x-forwarded-for (на Vercel — true):
# IP — правый адрес x-forwarded-for (его дописал прокси), без него — x-real-ip.
# false — оба заголовка не читаются (их может подделать клиент): IP неизвестен,
# лимиты входа считаются по номеру телефона и суточным потолкам для новых номеров.
# В NODE_ENV=production обязательно true — иначе приложение не стартует
TRUST_PROXY="false"

# ─── Персональные данные ─────────────────────────────────────
# Ключ AES-256-GCM для шифрования ИИН/БИН: 32 байта в base64.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=""
# Ключ HMAC для поиска по ИИН без расшифровки (32 байта в base64, другой, чем выше)
PII_HASH_KEY=""

# ─── Вход по SMS ─────────────────────────────────────────────
# mock — код показывается в демо-баннере (в лог не пишется); http — казахстанский SMS-шлюз (скелет).
# В production без DEMO_MODE mock запрещён
SMS_PROVIDER="mock"
# Для SMS_PROVIDER=http: адрес API, токен и имя отправителя от провайдера
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
SMS_SENDER="SENIM"
# Сколько кодов входа платформа отправляет за сутки на номера, которых нет среди пользователей (потолок
# расходов на SMS при рассылке на множество номеров с множества IP). Исчерпан — до конца суток закрыта
# только регистрация новых номеров; зарегистрированные входят по лимитам своего номера. При первом
# исчерпании за сутки — предупреждение в журнале и уведомление операторам
OTP_DAILY_GLOBAL_LIMIT="500"
# То же на префикс номера (первые 6 цифр): перебор соседних номеров не выбирает весь общий потолок
OTP_DAILY_PREFIX_LIMIT="50"

# ─── Подпись ЭЦП ─────────────────────────────────────────────
# mock — имитация подписи; sigex — подпись через eGov Mobile / NCALayer по SIGEX (скелет).
# В production без DEMO_MODE mock запрещён
SIGNATURE_PROVIDER="mock"
SIGEX_BASE_URL="https://sigex.kz"

# ─── Хранилище файлов ────────────────────────────────────────
# local — папка на диске (только разработка); s3 — любое S3-совместимое хранилище,
# в том числе облако в РК; vercel-blob — демо на Vercel
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
# Секрет для подписи ссылок на загрузку и скачивание (32+ символа)
FILE_URL_SECRET=""
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Токен Vercel Blob (подставляется Vercel при подключении хранилища).
# Хранилище Blob должно быть ПРИВАТНЫМ: файлы пишутся с access "private", доступ — по подписанным ссылкам
BLOB_READ_WRITE_TOKEN=""

# ─── ИИ-помощник ─────────────────────────────────────────────
# false — все функции ИИ скрыты
AI_ENABLED="false"
# mock — детерминированные ответы без внешних вызовов; gateway — реальный провайдер (ключ даёт владелец)
AI_PROVIDER="mock"
AI_GATEWAY_API_KEY=""
# Модели в формате «провайдер/модель»; обязательны при AI_ENABLED=true и AI_PROVIDER=gateway.
# После выбора добавьте их цены в src/modules/ai/pricing.ts (иначе расход оценивается сверху)
AI_TEXT_MODEL=""
AI_IMAGE_MODEL=""
# Сколько ИИ-иллюстраций можно сделать на одну заявку
AI_MAX_VISUALIZATIONS_PER_REQUEST="3"
# Суточный потолок расходов ИИ на всю платформу в долларах (сумма AiUsage.costUsdMicros за 24 часа).
# Исчерпан — помощник и иллюстрации отвечают «попробуйте завтра»
AI_DAILY_BUDGET_USD="20"

# ─── Контур (ТЗ п. 11, ADR-009) ──────────────────────────────
# dev — моки (провайдер mock); staging — песочница Freedom Pay; prod — пилот на manual-провайдере.
# В prod запрещены DEMO_MODE, mock SMS, подписи и платежей, провайдер freedompay
APP_ENV="dev"

# ─── Оплата ──────────────────────────────────────────────────
# Провайдер новых сделок. Пусто — по APP_ENV: dev → mock, staging → freedompay, prod → manual.
# mock — тестовые платежи, подтверждаются сразу (помечены «тестовый»);
# manual — оператор подтверждает операции по документам банка (эскроу Freedom Bank без API);
# freedompay — песочница Freedom Pay, только при APP_ENV=staging
PAYMENT_PROVIDER=""
# Для PAYMENT_PROVIDER=freedompay — выдаёт Freedom Pay (песочница). Реальные ключи в git не коммитим
FREEDOMPAY_API_URL=""
FREEDOMPAY_MERCHANT_ID=""
FREEDOMPAY_SECRET_KEY=""
FREEDOMPAY_PAYOUT_SECRET_KEY=""
# Устарело (до ТЗ v1.0): удаляется вместе со старым модулем payments
PAYMENT_RAIL="manual"
# Секрет подписи вебхуков симулятора эскроу (HMAC-SHA256, 32+ символа).
# Обязателен в production при PAYMENT_RAIL=escrow-simulator или DEMO_MODE=true;
# в разработке без него используется случайный секрет процесса
ESCROW_SIMULATOR_WEBHOOK_SECRET=""
# Для PAYMENT_RAIL=bank — выдаёт банк
BANK_API_URL=""
BANK_WEBHOOK_SECRET=""

# ─── Сделки ──────────────────────────────────────────────────
# Через сколько дней сданный этап принимается автоматически, если заказчик молчит
AUTO_ACCEPT_DAYS="5"
# Радиус мягкой проверки GPS при сдаче работы, метры: дальше — предупреждение, не блок
READY_GPS_RADIUS_M="500"

# ─── Уведомления ─────────────────────────────────────────────
# Web push: ключи VAPID (npx web-push generate-vapid-keys) и контакт mailto:… — задаются вместе.
# Пусто — push выключен, уведомления в приложении работают
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
# Отправка акта на e-mail: mock — письма в журнал разработки (реальный сервис выбирает владелец)
EMAIL_PROVIDER="mock"
EMAIL_FROM=""
# Координаты адреса заказа: mock — без внешнего геокодера (ключи даёт владелец)
GEOCODER_PROVIDER="mock"

# ─── Флаги Фазы 1 (src/platform/features.ts) ─────────────────
# Всё вне Фазы 1 ТЗ выключено по умолчанию; ИИ — AI_ENABLED выше.
# Сценарии до договора 2–5, замер, замерщик площадки, залог за выезд (ADR-005)
FEATURE_PRE_CONTRACT_FLOWS="false"
# Калькулятор материалов в мастере заявки (ADR-007)
FEATURE_MATERIALS_CALCULATOR="false"
# Отзывы, портфолио из сделки, «Вдохновение» — Фаза 2
FEATURE_REVIEWS="false"
FEATURE_DEAL_PORTFOLIO="false"
FEATURE_INSPIRATION="false"
# Маршрут публичной витрины сделки (страница — Фаза 2)
FEATURE_PUBLIC_SHOWCASE="false"
# Собственноручная подпись мастера на акте приёмки (кроме ЭЦП), OPEN_QUESTIONS №39
FEATURE_EXECUTOR_HAND_SIGNS_ACT="false"
# Телефон заказчика исполнителю по согласию до оферты (ADR-008), OPEN_QUESTIONS №40
FEATURE_CLIENT_PHONE_CONSENT="false"

# ─── Фоновые задачи ──────────────────────────────────────────
# Секрет для /api/cron/run (Vercel Cron передаёт его в заголовке Authorization)
CRON_SECRET=""

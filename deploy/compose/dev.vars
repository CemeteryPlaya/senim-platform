# Dev-only пароли баз данных и NATS. Это заглушки для локальной разработки, не секреты.
# В prod пароли выдаёт менеджер секретов; этот файл туда не попадает.
IDENTITY_OWNER_PASSWORD=dev-identity-owner
IDENTITY_APP_PASSWORD=dev-identity-app
DEAL_OWNER_PASSWORD=dev-deal-owner
DEAL_APP_PASSWORD=dev-deal-app
MARKETPLACE_OWNER_PASSWORD=dev-marketplace-owner
MARKETPLACE_APP_PASSWORD=dev-marketplace-app
DOCUMENTS_OWNER_PASSWORD=dev-documents-owner
DOCUMENTS_APP_PASSWORD=dev-documents-app
FILES_OWNER_PASSWORD=dev-files-owner
FILES_APP_PASSWORD=dev-files-app
NOTIFY_OWNER_PASSWORD=dev-notify-owner
NOTIFY_APP_PASSWORD=dev-notify-app
OPERATOR_OWNER_PASSWORD=dev-operator-owner
OPERATOR_APP_PASSWORD=dev-operator-app
AUDIT_OWNER_PASSWORD=dev-audit-owner
AUDIT_APP_PASSWORD=dev-audit-app

# Dev-only пароли учётных записей NATS (tools/natsconf → nats/nats.conf; ADR-012).
IDENTITY_NATS_PASSWORD=dev-identity-nats
DEAL_NATS_PASSWORD=dev-deal-nats
MARKETPLACE_NATS_PASSWORD=dev-marketplace-nats
DOCUMENTS_NATS_PASSWORD=dev-documents-nats
FILES_NATS_PASSWORD=dev-files-nats
NOTIFY_NATS_PASSWORD=dev-notify-nats
OPERATOR_NATS_PASSWORD=dev-operator-nats
AUDIT_NATS_PASSWORD=dev-audit-nats

# Ниже — переменные стенда v2 для docker compose (npm run v2:up передаёт файл через --env-file).
# Тоже dev-заглушки, не секреты.
POSTGRES_PASSWORD=dev-postgres
# Совпадает с паролем в postgres/init/01-web.sql (проверяет tools/dbinit/main_test.go).
WEB_DB_PASSWORD=dev-web
# MinIO — профиль storage (не входит в core).
MINIO_ROOT_USER=senim-dev
MINIO_ROOT_PASSWORD=dev-minio-password
# web в образе работает с NODE_ENV=production: секреты обязательны, значения — dev.
WEB_PII_ENCRYPTION_KEY=c2VuaW0tdjItZGV2LXBpaS1lbmNyeXB0aW9uLWtleSE=
WEB_PII_HASH_KEY=c2VuaW0tdjItZGV2LXBpaS1oYXNoLWtleS0zMmJ5dGU=
WEB_FILE_URL_SECRET=dev-file-url-secret-not-for-prod
WEB_CRON_SECRET=dev-cron-secret-not-for-prod
# Пусто в профиле core: телеметрия не отправляется. Профиль full переопределяет в full.vars (URL http://otel-lgtm:4317).
OTEL_EXPORTER_OTLP_ENDPOINT=

# identity: вход и сессии (план 2). Dev-заглушки, не секреты. Ключи — base64 от 32 байт.
IDENTITY_DEMO_MODE=true
IDENTITY_OTP_HMAC_KEY=c2VuaW0tdjItZGV2LWlkZW50aXR5LW90cC1obWFjISE=
IDENTITY_TOKEN_SIGNING_KEY=c2VuaW0tdjItZGV2LWlkZW50aXR5LXRva2VuLWtleSE=
IDENTITY_TOKEN_KID=dev-1
# Ключи ПДн identity (план 2б): KEK списком kid:base64 через запятую, текущий kid, ключ индекса.
IDENTITY_PII_KEKS=dev-1:c2VuaW0tdjItZGV2LWlkZW50aXR5LXBpaS1rZWstMSE=
IDENTITY_PII_KEK_CURRENT=dev-1
IDENTITY_PII_INDEX_KEY=c2VuaW0tdjItZGV2LWlkZW50aXR5LXBpaS1pbmRleCE=
